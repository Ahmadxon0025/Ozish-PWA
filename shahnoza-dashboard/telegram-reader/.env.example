# Telegram reader service env. Set these on your host (Railway/Render/…).
# api_id + api_hash from https://my.telegram.org → API development tools
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=your_api_hash_here
# Produced once by: python make_session.py  (full account access — secret!)
TELEGRAM_SESSION_STRING=
# Shared secret; must match TELEGRAM_READER_SECRET in the dashboard's env.
# Generate: openssl rand -hex 24
TELEGRAM_READER_SECRET=change-me-to-a-long-random-string
